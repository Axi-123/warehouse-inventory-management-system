{
  "info": {
    "_postman_id": "wims-backend-api-v1-postman-collection",
    "name": "Warehouse & Inventory Management System API",
    "description": "Complete REST API collection for Warehouse & Inventory Management System backend including all 13 modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "configure-in-postman",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "warehouseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondWarehouseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transferId",
      "value": "",
      "type": "string"
    },
    {
      "key": "movementId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warehouse User\",\n  \"email\": \"user@warehouse.com\",\n  \"password\": \"UserPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Warehouse Management",
      "item": [
        {
          "name": "Create Warehouse",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Distribution Hub\",\n  \"location\": \"Building A, Industrial Zone\",\n  \"capacity\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/warehouses",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses"]
            }
          }
        },
        {
          "name": "Get All Warehouses",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/warehouses",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses"]
            }
          }
        },
        {
          "name": "Get Warehouse By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/warehouses/{{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses", "{{warehouseId}}"]
            }
          }
        },
        {
          "name": "Update Warehouse",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Distribution Hub Expanded\",\n  \"capacity\": 75000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/warehouses/{{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses", "{{warehouseId}}"]
            }
          }
        },
        {
          "name": "Delete Warehouse",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/warehouses/{{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["warehouses", "{{warehouseId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Item & SKU Master",
      "item": [
        {
          "name": "Create Item (SKU)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LAP-DELL-XPS15\",\n  \"name\": \"Dell XPS 15 Laptop\",\n  \"category\": \"Electronics\",\n  \"unit\": \"pcs\",\n  \"unitPrice\": 1499.99,\n  \"reorderPoint\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "Get All Items",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items?search=Dell&category=Electronics",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                { "key": "search", "value": "Dell" },
                { "key": "category", "value": "Electronics" }
              ]
            }
          }
        },
        {
          "name": "Get Item By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            }
          }
        },
        {
          "name": "Update Item",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPrice\": 1399.99,\n  \"reorderPoint\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Stock Operations",
      "item": [
        {
          "name": "Stock-In Recording",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"itemId\": \"{{itemId}}\",\n  \"quantity\": 100,\n  \"reference\": \"PO-2026-001\",\n  \"batchNumber\": \"BATCH-991A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/stock/in",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "in"]
            }
          }
        },
        {
          "name": "Stock-Out Recording",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"itemId\": \"{{itemId}}\",\n  \"quantity\": 15,\n  \"reference\": \"SO-2026-881\",\n  \"reason\": \"Customer order dispatch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/stock/out",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "out"]
            }
          }
        },
        {
          "name": "Get Running Stock Balances",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stock/balance?warehouseId={{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "balance"],
              "query": [{ "key": "warehouseId", "value": "{{warehouseId}}" }]
            }
          }
        },
        {
          "name": "Get Low-Stock Alerts",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stock/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "low-stock"]
            }
          }
        },
        {
          "name": "Stock Audit Adjustment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"itemId\": \"{{itemId}}\",\n  \"newQuantity\": 85,\n  \"reason\": \"Annual physical audit reconciliation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/stock/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "adjust"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Inter-Warehouse Transfers",
      "item": [
        {
          "name": "Create Transfer Request",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWarehouseId\": \"{{warehouseId}}\",\n  \"toWarehouseId\": \"665e12345678901234567899\",\n  \"itemId\": \"{{itemId}}\",\n  \"quantity\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Get All Transfer Requests",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Approve Transfer Request",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/transfers/{{transferId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["transfers", "{{transferId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Transfer Request",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Insufficient capacity at receiving warehouse\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers/{{transferId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["transfers", "{{transferId}}", "reject"]
            }
          }
        },
        {
          "name": "Get Transfer Request By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transfers/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transfers", "{{transferId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Movement History Log",
      "item": [
        {
          "name": "Get Movement History",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/movements?movementType=IN&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["movements"],
              "query": [
                { "key": "movementType", "value": "IN" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Movement By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/movements/{{movementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movements", "{{movementId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Reports & Analytics",
      "item": [
        {
          "name": "Warehouse-wise Stock Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/warehouse-stock",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "warehouse-stock"]
            }
          }
        },
        {
          "name": "Stock Valuation Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/valuation",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "valuation"]
            }
          }
        },
        {
          "name": "Fast-Moving Items Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/fast-moving?days=30&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "fast-moving"],
              "query": [
                { "key": "days", "value": "30" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "8. User Administration",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Warehouse Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "role"]
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
